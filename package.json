{
  "name": "koinonia-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "typecheck": "tsc --noEmit",
    "migrate:production:gallery": "tsx scripts/run-production-migration.ts",
    "migrate:production:duty": "tsx scripts/run-event-duty-migration.ts",
    "migrate:production:whatsapp": "tsx scripts/run-whatsapp-delivery-migration.ts",
    "migrate:production:messaging": "tsx scripts/run-017-messaging-migration.ts",
    "worker:whatsapp": "tsx scripts/run-whatsapp-worker.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cloudinary": "^2.10.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "libphonenumber-js": "^1.13.8",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "resend": "^6.17.1",
    "sharp": "^0.35.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
