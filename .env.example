# Koinonia Children & Teens - Backend Server Configuration

# Server & Network
PORT=3000
NODE_ENV=development

# Database Connection (PostgreSQL / Neon)
DATABASE_URL=

# Authentication Secrets
JWT_SECRET=
JOB_SECRET=

# Allowed Origins & Public Application URLs
# In production, set to your Netlify frontend URL (e.g. https://koinonia12.netlify.app)
CORS_ORIGIN=http://localhost:5173,https://koinonia12.netlify.app
APP_BASE_URL=https://koinonia12.netlify.app
PUBLIC_APP_URL=https://koinonia12.netlify.app

# Transactional Email Configuration
# Supported providers: resend | zeptomail | smtp | simulated
EMAIL_PROVIDER=resend
EMAIL_FROM_ADDRESS=notifications@yourdomain.com
EMAIL_FROM_NAME="Koinonia Children & Teens"
EMAIL_REPLY_TO=support@yourdomain.com

# Resend Credentials (when EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# ZeptoMail Credentials (when EMAIL_PROVIDER=zeptomail)
ZEPTOMAIL_SEND_TOKEN=
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_TIMEOUT_MS=10000

# WhatsApp Delivery Configuration
# Supported providers: zoho | twilio | meta | simulated
WHATSAPP_PROVIDER=
# Worker modes: in_process | disabled | external
WHATSAPP_WORKER_MODE=

# Zoho CPaaS WhatsApp Credentials
ZOHO_WHATSAPP_API_URL=
ZOHO_WHATSAPP_API_KEY=
ZOHO_WHATSAPP_FROM=
ZOHO_WHATSAPP_TIMEOUT_MS=
ZOHO_WHATSAPP_WEBHOOK_SECRET=
ZOHO_WHATSAPP_WEBHOOK_MAX_AGE_MS=

# Zoho WhatsApp Template Mappings (template_key or template_alias)
ZOHO_WA_DEFAULT_TEMPLATE=
ZOHO_WA_TEMPLATE_REGISTRATION_ACK=
ZOHO_WA_TEMPLATE_REVIEW_DECISION=
ZOHO_WA_TEMPLATE_RETURN_TO_DRAFT=
ZOHO_WA_TEMPLATE_COMPLETION_REMINDER=
ZOHO_WA_TEMPLATE_INQUIRY_REPLY=
ZOHO_WA_TEMPLATE_VOLUNTEER_REPLY=
ZOHO_WA_TEMPLATE_DUTY_REMINDER=
ZOHO_WA_TEMPLATE_PICKUP_REMINDER=
ZOHO_WA_TEMPLATE_CHECKIN_OPENING=
ZOHO_WA_TEMPLATE_BROADCAST=
ZOHO_WA_TEMPLATE_ESCALATION=
ZOHO_WA_TEMPLATE_TEST=

# Twilio Credentials (fallback provider)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Meta Cloud API Credentials (fallback provider)
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=

# Cloudinary Media Storage (optional in development; uses local filesystem fallback if unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web Push (VAPID) Credentials
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Operational Settings
ALLOW_DEV_SEED=false
ALLOW_LOCAL_MEDIA_FALLBACK=true
ALLOW_PRODUCTION_MIGRATION=false
INVITATION_EXPIRY_HOURS=72

# SMTP Configuration (optional fallback)
SMTP_USER=
SMTP_PASS=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false

# Admin Bootstrap (used by scripts/bootstrap-admin.ts)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
