# Koinonia Children & Teens - Frontend Environment Configuration

# Backend API Base URL
# In local development: leave empty to use relative /api proxy
# In production (Netlify): set to your Render backend domain
# Example: https://mandate-2i7u.onrender.com
VITE_API_BASE_URL=

# Public Canonical Site URL
# Example: https://koinonia12.netlify.app
VITE_PUBLIC_SITE_URL=
